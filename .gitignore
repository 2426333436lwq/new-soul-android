re_work/host15/
re_work/host_smali/
re_work/smali_out/
re_work/apktool_out/
re_work/apk_raw/
re_work/vf_out/
re_work/_dump/
re_work/__pycache__/
_cfr_out/
_jadx_out/
_unpacked/
_soul_jadx/
_soul_unpacked/
_verify_cs/
_verify_dbg/
_verify_jadx/
_smali_out.zip

# ---------- 设备抓取产物（截图/日志/数据库，本地留档） ----------
.device/

# ---------- Android / Gradle 构建 ----------
.gradle/
build/
local.properties
*.iml
captures/
.externalNativeBuild/
.cxx/

# ---------- 逆向工具链（可重装） ----------
re_work/tools/

# ---------- 日志与临时文件 ----------
*.log
*.tmp
*.temp
*.bak
*.bak.*
__pycache__/
*.py[cod]

# ---------- 环境与密钥 ----------
.env
.env.local
*.pem
*.key
*.keystore
*.jks

# ---------- IDE / 工具残留 ----------
.reasonix/
reasonix.toml
